<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<title>${kind eq 'books' ? 'Quản lý sách' : 'Quản lý tác giả'} | BookVerse</title>
<section><div class="admin-title"><div><p class="eyebrow">QUẢN TRỊ BOOKVERSE</p><h1>${kind eq 'books' ? 'Quản lý sách' : 'Quản lý tác giả'}</h1></div><a class="button" href="${kind eq 'books' ? 'book-form' : 'author-form'}">+ Thêm mới</a></div><table><thead><tr><c:choose><c:when test="${kind eq 'books'}"><th>Ảnh bìa</th><th>Tên sách</th><th>Tác giả</th><th>ISBN</th><th>Giá</th><th>Số lượng</th></c:when><c:otherwise><th>#</th><th>Tên tác giả</th><th>Tiểu sử</th></c:otherwise></c:choose><th>Thao tác</th></tr></thead><tbody><c:forEach items="${items}" var="x"><tr><c:choose><c:when test="${kind eq 'books'}"><td><img class="thumb" src="${x.coverUrl}" alt=""></td><td>${x.title}</td><td>${x.author.name}</td><td>${x.isbn}</td><td>${x.formattedPrice} đ</td><td>${x.quantity}</td></c:when><c:otherwise><td>${x.id}</td><td>${x.name}</td><td>${x.biography}</td></c:otherwise></c:choose><td><a href="${kind eq 'books' ? 'book-form' : 'author-form'}?id=${x.id}">Sửa</a><form class="inline" method="post" action="${kind eq 'books' ? 'book-delete' : 'author-delete'}"><input type="hidden" name="id" value="${x.id}"><button class="danger" onclick="return confirm('Xóa mục này?')">Xóa</button></form></td></tr></c:forEach></tbody></table><nav class="pages"><c:forEach begin="1" end="${pages}" var="i"><a href="?page=${i}">${i}</a></c:forEach></nav></section>
