<%@ page contentType="text/html;charset=UTF-8" %><title>Quản lý tác giả | BookVerse</title><section class="edit"><h1>${empty author.id ? 'Thêm tác giả' : 'Cập nhật tác giả'}</h1><form method="post" action="author-save"><input type="hidden" name="id" value="${author.id}"><label>Tên tác giả<input name="name" value="${author.name}" required></label><label>Tiểu sử<textarea name="biography">${author.biography}</textarea></label><button>Lưu tác giả</button></form></section>
