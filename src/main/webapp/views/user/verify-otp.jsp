<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><title>Xác thực OTP | BookVerse</title><section class="auth"><div class="auth-image"><h1>Xác thực email<br><em>an toàn, riêng tư.</em></h1></div><form method="post"><p class="eyebrow">BƯỚC 2 / 2</p><h1>Nhập mã OTP</h1><p>Mã 6 số đã được gửi tới Gmail của bạn và hết hạn sau 5 phút.</p><c:if test="${not empty error}"><p class="error">${error}</p></c:if><label>Mã OTP<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required></label><button>Kích hoạt tài khoản →</button></form></section>
