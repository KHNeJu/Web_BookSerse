<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<title>${book.title} | BookVerse</title>
<section class="detail"><img src="${book.coverUrl}" alt="Bìa ${book.title}" onerror="this.src='https://placehold.co/520x780/063b35/f8f5ed?text=BookVerse'"><div><p class="eyebrow">CÔNG NGHỆ</p><h1>${book.title}</h1><p class="author">${book.author.name}</p><dl><dt>ISBN</dt><dd>${book.isbn}</dd><dt>Nhà xuất bản</dt><dd>${book.publisher}</dd><dt>Ngày xuất bản</dt><dd>${book.publisherDate}</dd><dt>Số lượng</dt><dd>${book.quantity} cuốn</dd><dt>Giá</dt><dd><strong>${book.formattedPrice} đ</strong></dd></dl><p>${book.description}</p><c:choose><c:when test="${book.quantity gt 0}"><form action="${pageContext.request.contextPath}/cart" method="post" class="add-cart"><input type="hidden" name="bookId" value="${book.id}"><label>Số lượng<input type="number" name="quantity" value="1" min="1" max="${book.quantity}" required></label><button>Thêm vào giỏ hàng</button></form></c:when><c:otherwise><p class="out-of-stock">Sách hiện đã hết hàng.</p></c:otherwise></c:choose></div></section>
<section class="reviews"><h2>Đánh giá (${reviews.size()})</h2><c:choose><c:when test="${empty reviews}"><p>Chưa có đánh giá.</p></c:when><c:otherwise><c:forEach items="${reviews}" var="r"><article><strong>${r.user.fullName}</strong> · ${r.rating}/5<p>${r.content}</p><time>${r.createdAt}</time></article></c:forEach></c:otherwise></c:choose><c:if test="${not empty sessionScope.user}"><form action="${pageContext.request.contextPath}/review" method="post"><input type="hidden" name="bookId" value="${book.id}"><label>Số sao<select name="rating"><option value="5">5 sao</option><option value="4">4 sao</option><option value="3">3 sao</option><option value="2">2 sao</option><option value="1">1 sao</option></select></label><label>Viết đánh giá<textarea name="content" required maxlength="1500"></textarea></label><button>Gửi đánh giá</button></form></c:if></section>
