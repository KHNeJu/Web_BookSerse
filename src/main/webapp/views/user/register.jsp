<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><title>Tạo tài khoản | BookVerse</title><section class="auth"><div class="auth-image"><h1>Sách hay<br><em>cho một cuộc sống đẹp hơn</em></h1></div><form method="post"><p class="eyebrow">BƯỚC 1 / 2</p><h1>Tạo tài khoản</h1><p>Chúng tôi sẽ gửi mã OTP tới Gmail của bạn.</p><c:if test="${not empty error}"><p class="error">${error}</p></c:if><label>Họ và tên<input name="name" required></label><label>Gmail<input name="email" type="email" required></label><label>Số điện thoại<input name="phone" type="tel" pattern="[0-9+ -]{8,20}" required></label><label>Mật khẩu<input name="password" type="password" minlength="8" required></label><button>Đăng ký →</button><p>Đã có tài khoản? <a href="login">Đăng nhập</a></p></form></section>
