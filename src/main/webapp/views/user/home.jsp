<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<title>BookVerse | Sách hay mỗi ngày</title>
<style>.shop-card{border:0;border-radius:0;background:#fff;box-shadow:none;padding:0 10px 18px}.shop-card .cover-link{height:300px;display:flex;align-items:center;justify-content:center;background:#fff8f1;padding:16px}.shop-card .cover-link img{width:82%;height:100%;object-fit:contain}.shop-card .card-info{padding:16px 0 0}.shop-card h3{height:46px;overflow:hidden;font:500 1rem Tahoma,Arial,sans-serif;line-height:1.35;color:#555}.shop-card .book-price{display:block;margin-top:10px;font:700 1.05rem Tahoma,Arial,sans-serif;color:#222}.shop-card form{display:flex;gap:.5rem;margin-top:.75rem}.shop-card form input{width:64px}.shop-card form button{padding:.6rem;flex:1}</style>
<section class="hero"><div><h1>Sách hay<br><em>cho một cuộc sống đẹp hơn</em></h1><p>Khám phá những cuốn sách giá trị, nuôi dưỡng tâm hồn mỗi ngày.</p></div></section>
<section id="books" class="catalog"><div class="section-head"><h2>Sản phẩm nổi bật</h2><span>${totalBooks} đầu sách</span></div><div class="grid"><c:forEach items="${books}" var="b"><article class="card shop-card"><a class="cover-link" href="${pageContext.request.contextPath}/book?id=${b.id}"><img src="${b.coverUrl}" alt="Bìa ${b.title}" onerror="this.src='https://placehold.co/360x540/fff8f1/777?text=BookVerse'"></a><div class="card-info"><h3><a href="${pageContext.request.contextPath}/book?id=${b.id}">${b.title}</a></h3><strong class="book-price">${b.formattedPrice} đ</strong><c:choose><c:when test="${b.quantity gt 0}"><form action="${pageContext.request.contextPath}/cart" method="post"><input type="hidden" name="bookId" value="${b.id}"><input type="number" name="quantity" value="1" min="1" max="${b.quantity}" aria-label="Số lượng"><button>Thêm vào giỏ</button></form></c:when><c:otherwise><p class="out-of-stock">Hết hàng</p></c:otherwise></c:choose></div></article></c:forEach></div><nav class="pages"><c:forEach begin="1" end="${pages}" var="i"><a class="${i eq page ? 'active' : ''}" href="?page=${i}">${i}</a></c:forEach></nav></section>
