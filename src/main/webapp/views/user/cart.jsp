<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<title>Giỏ hàng | BookVerse</title>
<section class="shop-page"><div class="section-head"><h1>Giỏ hàng</h1><a href="${pageContext.request.contextPath}/">← Tiếp tục mua sách</a></div>
<c:if test="${not empty error}"><p class="error">${error}</p></c:if>
<c:choose><c:when test="${empty cartItems}"><div class="empty-state"><h2>Giỏ hàng đang trống</h2><p>Hãy chọn một cuốn sách bạn yêu thích.</p><a class="button" href="${pageContext.request.contextPath}/">Xem sách</a></div></c:when><c:otherwise>
<div class="cart-layout"><div class="cart-list"><c:forEach items="${cartItems}" var="item"><article class="cart-item"><img src="${item.book.coverUrl}" alt="Bìa ${item.book.title}"><div class="cart-copy"><h3><a href="${pageContext.request.contextPath}/book?id=${item.book.id}">${item.book.title}</a></h3><p>${item.book.formattedPrice} đ / cuốn · còn ${item.book.quantity} cuốn</p><strong>${item.formattedSubtotal} đ</strong></div><form action="${pageContext.request.contextPath}/cart" method="post" class="quantity-form"><input type="hidden" name="action" value="update"><input type="hidden" name="bookId" value="${item.book.id}"><label>Số lượng<input name="quantity" type="number" min="1" max="${item.book.quantity}" value="${item.quantity}" required></label><button>Cập nhật</button></form><form action="${pageContext.request.contextPath}/cart" method="post"><input type="hidden" name="action" value="remove"><input type="hidden" name="bookId" value="${item.book.id}"><button class="danger">Xóa</button></form></article></c:forEach></div><aside class="cart-summary"><h2>Tóm tắt đơn hàng</h2><p><span>Tạm tính</span><strong>${cartTotal} đ</strong></p><p><span>Thanh toán</span><strong>COD</strong></p><a class="button block" href="${pageContext.request.contextPath}/checkout">Tiến hành đặt hàng</a></aside></div>
</c:otherwise></c:choose></section>
