<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<title>Thanh toán COD | BookVerse</title>
<section class="shop-page"><div class="section-head"><h1>Thanh toán đơn hàng</h1><a href="${pageContext.request.contextPath}/cart">← Quay lại giỏ hàng</a></div>
<c:if test="${not empty error}"><p class="error">${error}</p></c:if>
<div class="checkout-layout"><form method="post" class="checkout-form"><h2>Thông tin nhận hàng</h2><label>Họ và tên<input name="receiverName" value="${sessionScope.user.fullName}" maxlength="150" required></label><label>Số điện thoại<input name="phone" value="${sessionScope.user.phone}" maxlength="30" required></label><label>Địa chỉ nhận hàng<textarea name="address" maxlength="500" required></textarea></label><div class="cod-box"><strong>Thanh toán khi nhận hàng (COD)</strong><p>Bạn thanh toán ${cartTotal} đ cho nhân viên giao hàng khi nhận sách.</p></div><button>Đặt hàng COD</button></form><aside class="cart-summary"><h2>Đơn hàng</h2><c:forEach items="${cartItems}" var="item"><p><span>${item.book.title} × ${item.quantity}</span><strong>${item.formattedSubtotal} đ</strong></p></c:forEach><hr><p class="grand-total"><span>Tổng cộng</span><strong>${cartTotal} đ</strong></p></aside></div></section>
