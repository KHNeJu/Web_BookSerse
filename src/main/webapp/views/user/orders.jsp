<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<title>Lịch sử đặt hàng | BookVerse</title>
<section class="shop-page"><div class="section-head"><h1>Lịch sử đặt hàng</h1><a href="${pageContext.request.contextPath}/">Tiếp tục mua sách</a></div>
<c:if test="${not empty param.placed}"><p class="success">Đặt hàng COD thành công. Mã đơn của bạn là #${param.placed}.</p></c:if>
<form class="status-filter" method="get"><label>Trạng thái<select name="status" onchange="this.form.submit()"><option value="">Tất cả trạng thái</option><c:forEach items="${statuses}" var="status"><option value="${status}" ${selectedStatus eq status.toString() ? 'selected' : ''}>${status.label}</option></c:forEach></select></label><noscript><button>Lọc</button></noscript></form>
<c:choose><c:when test="${empty orders}"><div class="empty-state"><h2>Không có đơn hàng phù hợp</h2><p>Đơn hàng của bạn sẽ xuất hiện tại đây.</p></div></c:when><c:otherwise><div class="order-list"><c:forEach items="${orders}" var="order"><article class="order-card"><header><div><strong>Đơn #${order.id}</strong><time>${order.createdAtDisplay}</time></div><span class="status status-${order.status}">${order.statusLabel}</span></header><div class="order-items"><c:forEach items="${order.items}" var="item"><p><span>${item.title} × ${item.quantity}</span><strong>${item.formattedSubtotal} đ</strong></p></c:forEach></div><footer><span>COD · ${order.receiverName} · ${order.phone}<br>${order.address}</span><strong>Tổng: ${order.formattedTotal} đ</strong></footer></article></c:forEach></div></c:otherwise></c:choose></section>
